# Server
PORT=8080
PUBLIC_URL=http://localhost:8080
DATA_DIR=./data
NODE_ENV=development

# Set to true ONLY when this server runs behind a reverse proxy (Traefik/
# Caddy/Nginx) that sets X-Forwarded-For itself - otherwise rate limiting
# either becomes spoofable (set true without a real proxy) or collapses
# every client onto one shared bucket (left false behind a real proxy).
TRUST_PROXY=false

# Auth secrets - MUST be set to non-default values before the server will start.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional: separate pepper for pairing-code HMAC hashing. If unset, it is
# derived from JWT_SECRET.
PAIRING_CODE_PEPPER=

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# Registration
REGISTRATION_ENABLED=true
REGISTRATION_INVITE_CODE=

# Uploads / quota
MAX_UPLOAD_BYTES=15728640
MAX_IMAGES_PER_PAIRING=5000
MAX_STORAGE_BYTES_PER_USER=5368709120
# Uploads decoded/re-encoded in parallel (each holds full-size frames in memory).
MAX_CONCURRENT_UPLOADS=2

# Background maintenance: blob GC, refcount check, stale upload temp files,
# expired pairing codes, revoked refresh tokens. 0 disables the job.
MAINTENANCE_INTERVAL_MINUTES=60

# Comma-separated origins allowed for browser CORS (HTTP API and Socket.IO).
# Empty in production = no cross-origin browser access (the native apps and
# the same-origin admin panel do not need it). Outside production,
# http(s)://localhost:<port> is always allowed when this is empty.
CORS_ORIGINS=

# Backups
BACKUP_RETENTION_DAYS=14
